pipeline {
  agent any
  options { timestamps(); ansiColor('xterm') }

  environment {
    SUBDIR      = 'backend'
    IMAGE_NAME  = 'sso9594/agzak-app'
    REGISTRY    = 'docker.io'
    DEPLOY_USER = 'ubuntu'
    DEPLOY_HOST = 'k13b102.p.ssafy.io'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          def full = (env.GIT_BRANCH ?: '').replaceFirst(/^origin\//, '')
          if (!full) { full = sh(returnStdout: true, script: 'git rev-parse --abbrev-ref HEAD').trim() }
          env.TARGET_BRANCH_FULL = full
          env.TARGET_BRANCH = full.replaceAll('/', '-')
          echo "Target branch: ${env.TARGET_BRANCH_FULL} -> ${env.TARGET_BRANCH}"
        }
      }
    }

    stage('Kaniko Build & Push') {
      steps {
        dir("${env.SUBDIR}") {
          withCredentials([usernamePassword(
            credentialsId: 'dockerhub-cred',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PWD'
          )]) {
            sh '''#!/usr/bin/env bash
    set -euo pipefail
    set -x

    TAG="${TARGET_BRANCH}-${BUILD_NUMBER}"

    # 목적지 레포 / 인증 레지스트리
    if [[ -n "${REGISTRY}" && "${REGISTRY}" != "docker.io" ]]; then
      DEST_REPO="${REGISTRY}/${IMAGE_NAME}"
      AUTH_REGISTRY="${REGISTRY}"
    else
      DEST_REPO="docker.io/${IMAGE_NAME}"
      AUTH_REGISTRY="https://index.docker.io/v1/"
    fi

    # Kaniko 인증 파일 (heredoc 대신 printf로 안전하게 생성)
    DOCKERCFG="${WORKSPACE}/kaniko-config"
    mkdir -p "${DOCKERCFG}"
    AUTH="$(printf "%s:%s" "${DOCKER_USER}" "${DOCKER_PWD}" | base64 | tr -d '\n')"
    printf '{"auths":{"%s":{"auth":"%s"}}}\n' "${AUTH_REGISTRY}" "${AUTH}" > "${DOCKERCFG}/config.json"

    # 경로/작업 디렉토리
    WORKDIR="$(pwd)"
    DF="${WORKDIR}/Dockerfile"

    # Kaniko 작업 디렉토리 (쓰기 가능 경로)
    export DOCKER_CONFIG="${DOCKERCFG}"
    export KANIKO_DIR="${WORKSPACE}/.kaniko"
    mkdir -p "${KANIKO_DIR}"

    # Kaniko 바이너리 확인 (없으면 즉시 실패)
    command -v /kaniko/executor >/dev/null || { echo "kaniko executor not found"; exit 1; }
    /kaniko/executor version || true

    # 빌드 & 푸시
    /kaniko/executor \
      --context=dir://"${WORKDIR}" \
      --dockerfile="${DF}" \
      --kaniko-dir="${KANIKO_DIR}" \
      --destination="${DEST_REPO}:${TAG}" \
      --destination="${DEST_REPO}:latest" \
      --use-new-run \
      --single-snapshot \
      --cache=true \
      --cache-repo="${DEST_REPO}-cache"

    # 완성 태그 확인 (옵션)
    /kaniko/executor --no-push --digest-file "${WORKSPACE}/kaniko-digest.txt" || true
    '''
          }
        }
      }
    }

    stage('Deploy') {
      steps {
        sshagent (credentials: ['deploy-ssh']) {
          withCredentials([usernamePassword(
            credentialsId: 'dockerhub-cred',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PWD'
          )]) {
            script {
              def repo = (env.REGISTRY?.trim() && env.REGISTRY != 'docker.io')
                ? "${env.REGISTRY}/${env.IMAGE_NAME}"
                : "docker.io/${env.IMAGE_NAME}"
              def tag = "${env.TARGET_BRANCH}-${env.BUILD_NUMBER}"
              def testImage = "${repo}:${tag}"

              sh """
                set -eux
                ssh -o StrictHostKeyChecking=no \\
                  "$DEPLOY_USER@$DEPLOY_HOST" \\
                  "TEST_IMAGE=${testImage} DOCKER_USER=${DOCKER_USER} DOCKER_PWD=${DOCKER_PWD} bash -s" <<'ENDSSH'
                    set -eux
                    cd /home/ubuntu/agzak-app/test/backend

                    sed -i '/^TEST_IMAGE=/d' .env
                    sed -i '/^PROJECT=/d' .env
                    echo "TEST_IMAGE=\$TEST_IMAGE" >> .env
                    echo "PROJECT=test" >> .env

                    echo "\$DOCKER_PWD" | docker login -u "\$DOCKER_USER" --password-stdin || true

                    make -C .. up-be

                    for i in \$(seq 1 12); do
                      status=\$(docker inspect --format '{{.State.Health.Status}}' test-app-server 2>/dev/null || echo "unhealthy")
                      echo "Current status: \$status"
                      [ "\$status" = "healthy" ] && { echo "Container is healthy."; exit 0; }
                      echo "Waiting for container to be healthy... (\$i/12)"
                      sleep 5
                    done

                    echo "Container did not become healthy in time." >&2
                    exit 1
                ENDSSH
              """
            }
          }
        }
      }
    }
  }

  post {
    success {
      script {
        def Author_ID = sh(script: "git show -s --pretty=%an", returnStdout: true).trim()
        def Author_Name = sh(script: "git show -s --pretty=%ae", returnStdout: true).trim()
        sh """
          curl -X POST -H 'Content-Type: application/json' \
          -d '{"text":"빌드 성공: ${env.JOB_NAME} #${env.BUILD_NUMBER} by ${Author_ID}(${Author_Name}) (<${env.BUILD_URL}|상세 보기>)"}' \
          https://meeting.ssafy.com/hooks/j6qmearua7fx7pi8auyuyx1reo
        """
      }
    }
    failure {
      script {
        def Author_ID = sh(script: "git show -s --pretty=%an", returnStdout: true).trim()
        def Author_Name = sh(script: "git show -s --pretty=%ae", returnStdout: true).trim()
        sh """
          curl -X POST -H 'Content-Type: application/json' \
          -d '{"text":"빌드 실패: ${env.JOB_NAME} #${env.BUILD_NUMBER} by ${Author_ID}(${Author_Name}) (<${env.BUILD_URL}|상세 보기>)"}' \
          https://meeting.ssafy.com/hooks/j6qmearua7fx7pi8auyuyx1reo
        """
      }
    }
  }
}