pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
  }

  environment {
    SUBDIR      = 'backend'
    IMAGE_NAME  = 'sso9594/agzak-app'
    REGISTRY    = 'docker.io'
    DEPLOY_USER = 'ubuntu'
    DEPLOY_HOST = 'k13b102.p.ssafy.io'

    EDGE_CONF   = '/home/ubuntu/agzak-app/deploy/infra/nginx/data/active_slot.conf'
    BE_COMPOSE  = '/home/ubuntu/agzak-app/deploy/backend/agzak-app-server.yml'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          def full = (env.GIT_BRANCH ?: '').replaceFirst(/^origin\//, '')
          if (!full) {
            full = sh(returnStdout: true, script: 'git rev-parse --abbrev-ref HEAD').trim()
          }
          env.TARGET_BRANCH_FULL = full
          env.TARGET_BRANCH = full.replaceAll('/', '-')
          echo "Target branch: ${env.TARGET_BRANCH_FULL} -> ${env.TARGET_BRANCH}"
        }
      }
    }

    stage('Docker Build & Push') {
      steps {
        dir("${env.SUBDIR}") {
          withCredentials([usernamePassword(credentialsId: 'dockerhub-cred',
              usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PWD')]) {
            sh '''
              set -eux

              echo "$DOCKER_PWD" | docker login -u "$DOCKER_USER" --password-stdin ${REGISTRY}

              export DOCKER_BUILDKIT=1
              TAG="${TARGET_BRANCH}-${BUILD_NUMBER}"

              if [ -n "${REGISTRY}" ] && [ "${REGISTRY}" != "docker.io" ]; then
                REPO="${REGISTRY}/${IMAGE_NAME}"
              else
                REPO="${IMAGE_NAME}"
              fi

              docker build -t "${REPO}:${TAG}" .

              docker push "${REPO}:${TAG}"

              docker tag "${REPO}:${TAG}" "${REPO}:latest"
              docker push "${REPO}:latest"
            '''
          }
        }
      }
    }

    stage('Deploy (Blue/Green)') {
      steps {
        sshagent(credentials: ['deploy-ssh']) {
          withCredentials([usernamePassword(
            credentialsId: 'dockerhub-cred',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PWD'
          )]) {
            script {
              def repo = (env.REGISTRY?.trim() && env.REGISTRY != 'docker.io')
                ? "${env.REGISTRY}/${env.IMAGE_NAME}"
                : env.IMAGE_NAME
              def tag   = "${env.TARGET_BRANCH}-${env.BUILD_NUMBER}"
              def image = "${repo}:${tag}"

              // 원격에서 쓸 이미지 이름만 env로 넘김
              env.DEPLOY_IMAGE = image

              // ⬇ 안쪽은 순수 bash. Groovy는 건드리지 않는다 (''' 사용).
              sh '''#!/bin/bash
    set -Eeuo pipefail

    ssh -o StrictHostKeyChecking=no "$DEPLOY_USER@$DEPLOY_HOST" \
      IMAGE="$DEPLOY_IMAGE" \
      EDGE_CONF="$EDGE_CONF" \
      BE_COMPOSE="$BE_COMPOSE" \
      DOCKER_USER="$DOCKER_USER" \
      DOCKER_PWD="$DOCKER_PWD" \
      bash -s << 'EOF'

    set -Eeuo pipefail

    echo "$DOCKER_PWD" | docker login -u "$DOCKER_USER" --password-stdin || true

    # 0) active_slot.conf 없으면 기본 blue로 생성
    if [ ! -f "$EDGE_CONF" ]; then
      echo 'set $slot blue;' > "$EDGE_CONF"
    fi

    # 1) 현재 활성 슬롯 읽기 → 대기 슬롯 결정
    CUR_SLOT=$(grep -oE '(blue|green)' "$EDGE_CONF" || echo blue)
    if [ "$CUR_SLOT" = "blue" ]; then
      IDLE_SLOT=green
    else
      IDLE_SLOT=blue
    fi
    echo "Current=$CUR_SLOT, Idle=$IDLE_SLOT, IMAGE=$IMAGE"

    export IMAGE

    # 2) Idle 슬롯 컨테이너 잔여분 있으면 제거
    if docker ps -a --format '{{.Names}}' | grep -q "^agzak-be-$IDLE_SLOT$"; then
      echo "Existing container agzak-be-$IDLE_SLOT found. Removing..."
      docker rm -f "agzak-be-$IDLE_SLOT" || true
    fi

    # 3) Idle 슬롯만 올리기
    docker compose -f "$BE_COMPOSE" up -d --no-deps "agzak-be-$IDLE_SLOT"

    # 4) 헬스 체크
    for i in $(seq 1 24); do
      status=$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "agzak-be-$IDLE_SLOT" 2>/dev/null || true)
      [ "$status" = "healthy" ] && { echo "Idle slot healthy"; break; }
      echo "Waiting health ($i/24): $status"; sleep 5
    done

    status=$(docker inspect --format='{{.State.Health.Status}}' "agzak-be-$IDLE_SLOT" 2>/dev/null || echo "unknown")
    [ "$status" = "healthy" ] || { echo "Idle slot not healthy in time ($status)"; exit 1; }

    # 5) 업스트림 스위치 + Nginx reload (락)
    /usr/bin/env bash -c '
      set -Eeuo pipefail
      (
        flock -n 9 || { echo "Another deployment in progress"; exit 1; }

        # 여기서 \$slot은 literal, IDLE_SLOT은 위에서 계산된 값
        echo "set \\$slot '"'"'$IDLE_SLOT'"'"';" > "$EDGE_CONF"

        docker exec agzak-nginx nginx -t
        docker exec agzak-nginx nginx -s reload
      ) 9>/var/lock/agzak-be-deploy.lock
    '

    # 6) (옵션) 이전 슬롯 중지
    # docker compose -f "$BE_COMPOSE" stop "agzak-be-$CUR_SLOT" || true

    EOF
    '''
            }
          }
        }
      }
    }
  }

  post {
    success {
      script {
        def Author_ID = sh(script: "git show -s --pretty=%an", returnStdout: true).trim()
        def Author_Name = sh(script: "git show -s --pretty=%ae", returnStdout: true).trim()
        sh """
          curl -X POST -H 'Content-Type: application/json' \
          -d '{"text":"빌드 성공: ${env.JOB_NAME} #${env.BUILD_NUMBER} by ${Author_ID}(${Author_Name}) (<${env.BUILD_URL}|상세 보기>)"}' \
          https://meeting.ssafy.com/hooks/j6qmearua7fx7pi8auyuyx1reo
        """
      }
    }
    failure {
      script {
        def Author_ID = sh(script: "git show -s --pretty=%an", returnStdout: true).trim()
        def Author_Name = sh(script: "git show -s --pretty=%ae", returnStdout: true).trim()
        sh """
          curl -X POST -H 'Content-Type: application/json' \
          -d '{"text":"빌드 실패: ${env.JOB_NAME} #${env.BUILD_NUMBER} by ${Author_ID}(${Author_Name}) (<${env.BUILD_URL}|상세 보기>)"}' \
          https://meeting.ssafy.com/hooks/j6qmearua7fx7pi8auyuyx1reo
        """
      }
    }
  }
}