pipeline {
    agent any

    options {
        timestamp();
        ansiColor('xterm');
    }

    environment {
        SUBDIR = 'backend'
        IMAGE_NAME = 'sso9594/agzak-app'
        REGISTRY = 'docker.io'
        DEPLOY_USER = 'ubuntu'
        DEPLOY_HOST = 'k13b102.p.ssafy.io'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    dev full = (env.GIT_BRANCH ?: '').replaceFirst(/^origin\//, '')
                    if(!full) full = sh(returnStdout: true, script: 'git rev-parse --abbrev-ref HEAD').trim()
                    env.TARGET_BRANCH_FULL = full
                    env.TARGET_BRANCH = full.replaceAll('/', '-')
                    echo "Target branch: ${env.TARGET_BRANCH_FULL} -> ${env.TARGET_BRANCH}"
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                dir("${env.SUBDIR}") {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-cred',
                    usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PWD')]) {
                        sh '''
                            set -eux
                            echo "$DOCKER_PWD" | docker login -u "$DOCKER_USER" --password-stdin ${env.REGISTRY}

                            export DOCKER_BUILDKIT=1
                            TAG=${TARGET_BRANCH}-${BUILD_NUMBER}

                            docker build -t ${IMAGE_NAME}:${TAG}
                            docker push ${IMAGE_NAME}:${TAG}

                            docker tag ${IMAGE_NAME}:${TAG} ${IMAGE_NAME}:latest
                            docker push ${IMAGE_NAME}:latest
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                sshagent (credentials: ['deploy-ssh']) {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-cred')]) {
                        usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PWD']]) {
                            script {
                                def TAG = ${env.TARGET_BRANCH}-${env.BUILD_NUMBER}
                                def IMG = (env.REGISTRY?.trim())
                                    ? "${env.REGISTRY}/${env.IMAGE_NAME}:${TAG}"
                                    : "${env.IMAGE_NAME}:${TAG}"
                                withEnv(["FULL_IMAGE=${IMG}"]) {
                                    sh '''
                                        set -eux
                                        ssh -o StrictHostKeyChecking=no "$DEPLOY_HOST@$DEPLOY_USER" \
                                        "DOCKER_USER='$DOCKER_USER' DOCKER_PWD='$DOCKER_PWD' FULL_IMAGE='$FULL_IMAGE' bash -s" << 'ENDSSH'
                                        set -eux
                                        cd /home/ubuntu/agzak-app/deploy/backend
                                        [ -f Makefile ] || {echo "Makefile not found!"; exit 2;}

                                        echo "$DOCKER_PWD" | docker login -u "$DOCKER_USER" --password-stdin || true

                                        IMAGE="FULL_IMAGE" make up-be

                                        for i in $(seq 1 12); do
                                            status=$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' agzak-app-server || echo "unhealthy")
                                            [ "$status" = "healthy" ] && { echo "Container is healthy."; exit 0; }
                                            echo "Waiting for container to be healthy... ($i/12)"
                                            sleep 5
                                        done

                                        echo "Container did not become healthy in time." > &2; exit 1

                                        EOS
                                    '''
                            }
                        }
                    }
                }
            }
        }
    }
}